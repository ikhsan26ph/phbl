# Template env per target. Salin ke .env.<target> (mis. .env.demo, .env.local)
# lalu isi kredensial secara lokal. JANGAN commit file .env.* selain file ini.
#
# Target dipilih lewat variabel shell TARGET_ENV (demo | local, default demo):
#   TARGET_ENV=local npx playwright test
# TARGET_ENV dibaca SEBELUM file env dimuat, jadi mengisinya di file ini tidak
# berpengaruh — tercantum di sini hanya sebagai dokumentasi.
#
# Pemetaan peran (dipakai konsisten di seluruh project):
# - Bid Owner  = Shipper      (di UI ditampilkan sebagai "Pemilik Barang")
# - Bidder     = Transporter  (di UI ditampilkan sebagai "Ekspedisi")
# Dokumen rule memakai istilah Bid Owner/Bidder, UI memakai Pemilik Barang/Ekspedisi.

TARGET_ENV=
BASE_URL=
ADMIN_PATH=/

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SUB_EMAIL=
ADMIN_SUB_PASSWORD=
# Sub admin hak akses baca-saja (project admin-sub-read). Kosong = login di-skip.
ADMIN_SUB_READ_EMAIL=
ADMIN_SUB_READ_PASSWORD=

SHIPPER_EMAIL=
SHIPPER_PASSWORD=
SHIPPER_SUB_EMAIL=
SHIPPER_SUB_PASSWORD=

TRANSPORTER_EMAIL=
TRANSPORTER_PASSWORD=
TRANSPORTER_SUB_EMAIL=
TRANSPORTER_SUB_PASSWORD=
