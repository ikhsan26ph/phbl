# Template env. Salin ke `.env` di root repository lalu isi nilainya secara
# lokal. `.env` adalah SATU-SATUNYA file env aktif (dibaca scripts/env.js);
# .env.demo/.env.local lama tidak dibaca lagi. JANGAN commit `.env`.
#
# Nilai di `.env` selalu menang atas variabel shell untuk BASE_URL, ADMIN_PATH,
# dan <AKUN>_EMAIL/_PASSWORD. Variabel kontrol run (TARGET_ENV = label target,
# default local; PW_RUN_ID; dst.) diset lewat shell, BUKAN di file ini.
#
# URL tunnel bisa berubah: cukup ganti BASE_URL, lalu jalankan ulang project
# setup (cookie sesi terikat host, sesi host lama tidak berlaku).
#
# Pemetaan peran (dipakai konsisten di seluruh project):
# - Bid Owner  = Shipper      (di UI ditampilkan sebagai "Pemilik Barang")
# - Bidder     = Transporter  (di UI ditampilkan sebagai "Ekspedisi")
# Dokumen rule memakai istilah Bid Owner/Bidder, UI memakai Pemilik Barang/Ekspedisi.

BASE_URL="https://<host-aplikasi>/"
ADMIN_PATH=/

ADMIN_EMAIL="<email-admin>"
ADMIN_PASSWORD="<password-admin>"
ADMIN_SUB_EMAIL="<email-sub-admin>"
ADMIN_SUB_PASSWORD="<password-sub-admin>"
# Sub admin hak akses baca-saja (project admin-sub-read). OPSIONAL; kosong =
# login & test admin-sub-read di-skip. Jangan isi dgn akun ADMIN_SUB (sesi
# server tunggal per akun → login kedua menendang sesi admin-sub).
ADMIN_SUB_READ_EMAIL=
ADMIN_SUB_READ_PASSWORD=

SHIPPER_EMAIL="<email-shipper>"
SHIPPER_PASSWORD="<password-shipper>"
SHIPPER_SUB_EMAIL="<email-sub-shipper>"
SHIPPER_SUB_PASSWORD="<password-sub-shipper>"

TRANSPORTER_EMAIL="<email-transporter>"
TRANSPORTER_PASSWORD="<password-transporter>"
TRANSPORTER_SUB_EMAIL="<email-sub-transporter>"
TRANSPORTER_SUB_PASSWORD="<password-sub-transporter>"
